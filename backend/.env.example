# ---- Base de datos ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asistenciaapp

# ---- Seguridad ----
# NUNCA reutilices los valores de ejemplo de abajo: son publicos (este archivo esta en el repo).
# Genera valores unicos por entorno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   -> JWT_SECRETO
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      -> CLAVE_CIFRADO
JWT_SECRETO=cambia_esta_clave_en_produccion
# Clave de cifrado AES-256 para plantillas biometricas (64 caracteres hex = 32 bytes). Obligatoria: el servidor no arranca sin ella.
CLAVE_CIFRADO=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- Servidor ----
PUERTO=4000
URL_FRONTEND=http://localhost:5173

# ---- Correo (si se deja vacio, los correos se imprimen en consola) ----
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
CORREO_REMITENTE="AsistenciaApp <no-responder@asistenciaapp.co>"
